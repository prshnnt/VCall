# ── Cloudflare TURN (Calls) ─────────────────────────────────────────────────
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_TURN_TOKEN=your_cloudflare_turn_token          # Cloudflare Calls API token
CF_TURN_TTL=86400                                  # credential TTL in seconds (24h)

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0                 # or rediss:// for TLS

# ── App ──────────────────────────────────────────────────────────────────────
APP_SECRET_KEY=change_me_to_a_random_secret
ROOM_MAX_PEERS=10                                  # max peers per room
SESSION_TTL=3600                                   # room session TTL in seconds
